# Cogwheel DNS — configuration template.
#
#   cp .env.example .env
#   $EDITOR .env
#   docker compose up -d
#
# `.env` is read by Docker Compose for two things: interpolating ${VAR} in
# docker-compose.yml, and (via `env_file:`) injecting the COGWHEEL_* variables
# into the container. It is git-ignored — never commit a filled-in copy.
#
# Every COGWHEEL_* name below is read once at startup by
# apps/cogwheel-server/src/config.rs. Names are exact; an unknown variable is
# silently ignored rather than reported, so copy them verbatim, and a variable
# that IS recognised but does not parse fails startup rather than falling back
# to a default nobody chose.

# ===========================================================================
# Image and container
# ===========================================================================
# Pin a released tag in production. `latest` is fine for a first look, but it
# turns every `docker compose pull` into an unreviewed upgrade.
COGWHEEL_IMAGE=ghcr.io/thekozugroup/cogwheel-dns:latest
COGWHEEL_CONTAINER_NAME=cogwheel
COGWHEEL_VOLUME_NAME=cogwheel-data

# ===========================================================================
# Deployment profile
# ===========================================================================
# dev  — loopback only, high ports (127.0.0.1:30080 / :30053). Local hacking.
# home — default household profile (0.0.0.0:8080 / :5353).
# smb  — accepted as an alias of home. There is no third set of defaults; an
#        install that already set smb keeps working rather than failing to boot.
#
# The profile only sets DEFAULTS. Any explicit variable below wins over it.
COGWHEEL_PROFILE=home

# ===========================================================================
# Bind addresses
# ===========================================================================
# With host networking (the default in docker-compose.yml) these are host
# sockets, so DNS binds :53 directly. The image grants the binary
# CAP_NET_BIND_SERVICE via a file capability so this works as a non-root user.
COGWHEEL_SERVER__HTTP_BIND_ADDR=0.0.0.0:8080
COGWHEEL_SERVER__DNS_UDP_BIND_ADDR=0.0.0.0:53
COGWHEEL_SERVER__DNS_TCP_BIND_ADDR=0.0.0.0:53

# If you switched docker-compose.yml to bridge networking (Option B), use the
# unprivileged port inside the container and publish it as 53 on the host:
# COGWHEEL_SERVER__DNS_UDP_BIND_ADDR=0.0.0.0:5353
# COGWHEEL_SERVER__DNS_TCP_BIND_ADDR=0.0.0.0:5353

# ===========================================================================
# What the UI tells users to point their router at
# ===========================================================================
# ADVERTISED_DNS_PORT is the port CLIENTS use, which is not necessarily the
# port the process bound. With bridge networking you bind 5353 but clients
# still talk to 53, so this must stay 53.
COGWHEEL_SERVER__ADVERTISED_DNS_PORT=53

# Comma-separated addresses/hostnames shown on the Overview page and in
# GET /api/v1/overview's `connect.targets`. Put this node's LAN address here.
# On a dual-stack network list the IPv6 address too: a client that keeps an
# IPv6 resolver configured will bypass an IPv4-only DNS setting entirely.
# Left unset, the server asks the host itself (`hostname -I`) instead.
# scripts/install.sh fills this in automatically from the host's interfaces.
# COGWHEEL_SERVER__ADVERTISED_DNS_TARGETS=cogwheel.lan,10.0.0.2

# Directory holding the built web bundle (the one with index.html in it). Left
# unset the server searches ./apps/cogwheel-web/dist, ./dist and /app/web, which
# covers the container image and a cargo run from the repo root. Set it for a
# native install that puts the bundle anywhere else.
# COGWHEEL_WEB_DIST_DIR=/usr/share/cogwheel/web

# ===========================================================================
# Storage
# ===========================================================================
# The `sqlite://` prefix is stripped by Storage::connect, leaving an absolute
# path. Keep it inside /app/data — that is the mounted volume.
COGWHEEL_STORAGE__DATABASE_URL=sqlite:///app/data/cogwheel.db

# ===========================================================================
# Upstream resolvers
# ===========================================================================
# Comma-separated. Cleartext entries are registered for both UDP and TCP.
#
#   1.1.1.1:53                                     cleartext (visible to the ISP)
#   tls://1.1.1.1#cloudflare-dns.com               DNS-over-TLS,   port 853
#   https://1.1.1.1#cloudflare-dns.com/dns-query   DNS-over-HTTPS, port 443
#
# The default below is CLEARTEXT, because that is what works on every network
# without configuration. It also means the name of every site every device in
# the house looks up is readable by the local network and by your ISP. Blocking
# trackers while handing that same list to the network operator is an odd place
# to stop, so consider one of the encrypted forms:
#
#   Cloudflare: tls://1.1.1.1#cloudflare-dns.com,tls://1.0.0.1#cloudflare-dns.com
#   Quad9:      tls://9.9.9.9#dns.quad9.net,tls://149.112.112.112#dns.quad9.net
#   Google:     tls://8.8.8.8#dns.google,tls://8.8.4.4#dns.google
#
# The part after '#' is the name the server's certificate must match, and it is
# required. Writing `tls://cloudflare-dns.com` instead would mean resolving that
# name first -- in cleartext, on every restart -- which is the leak being fixed.
# There is no option to skip certificate verification.
#
# Do not mix encrypted and cleartext entries: queries are spread across all of
# them, so one cleartext entry leaks a share of them. Cogwheel warns if you do.
#
# Cleartext (default -- change to a tls:// pair above to encrypt):
COGWHEEL_UPSTREAM__SERVERS=1.1.1.1:53,1.0.0.1:53

# ===========================================================================
# How long observed history is kept
# ===========================================================================
# The query log (Activity page, GET /api/v1/queries) is what lets a household
# ask "why did this break last week". It is also a record of every name every
# device in the house looked up, on a box sitting in the hall, so it is worth
# keeping deliberately short rather than defaulting to forever.
#
# Default is 7 days. Set to 0 to stop writing the query log at all -- the
# hourly rollups behind the Overview page's charts and the per-device counts
# are kept either way, since they are counts, not browsing history.
# COGWHEEL_RETENTION__HISTORY_DAYS=7
#
# A hard cap on rows, enforced by the same prune, for a household whose query
# volume would otherwise fill HISTORY_DAYS with more rows than the appliance's
# disk (or a Pi's SD card) should hold.
# COGWHEEL_RETENTION__QUERY_LOG_MAX_ROWS=250000
#
# How often the prune runs. Floored at 60s.
# COGWHEEL_RETENTION__PRUNE_INTERVAL_SECS=3600

# ===========================================================================
# How blocked names are answered
# ===========================================================================
# null_ip  (default) 0.0.0.0 / ::
# nxdomain           as if the name did not exist
# nodata             NOERROR with no answers
# refused            REFUSED
#
# null_ip is the default because it is what clients handle most predictably.
# COGWHEEL_BLOCKING__MODE=null_ip

# ===========================================================================
# Blocklist refresh
# ===========================================================================
# Seconds between scheduled refreshes of a healthy, subscribed list. Default is
# 86400 (daily), which is how often these lists actually change; floored at
# 300 s regardless of what you set, so this cannot be turned into a poll loop
# against somebody else's server. A list that is currently failing retries on
# its own fixed 300 s schedule no matter what this is set to.
# COGWHEEL_UPDATER__REFRESH_INTERVAL_SECS=86400

# ===========================================================================
# Logging
# ===========================================================================
# tracing/EnvFilter syntax. An `info` directive is always added on top of
# whatever you set, so this can only widen the filter.
# RUST_LOG=info,cogwheel_server=debug

# ===========================================================================
# Compose-level knobs (not read by the server)
# ===========================================================================
# Sized for a Raspberry Pi 5. Lower the CPU limit to 1.5 on a 4 GB Pi that is
# also running other services.
COGWHEEL_CPU_LIMIT=2.0
COGWHEEL_MEMORY_LIMIT=1024M
COGWHEEL_MEMORY_RESERVATION=192M

COGWHEEL_LOG_MAX_SIZE=10m
COGWHEEL_LOG_MAX_FILE=3

COGWHEEL_STOP_GRACE_PERIOD=20s

# Only used when docker-compose.yml is switched to bridge networking.
# COGWHEEL_DNS_HOST_PORT=53
# COGWHEEL_HTTP_HOST_PORT=8080
